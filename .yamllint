# yamllint configuration for the Home Assistant config repo.
# Home Assistant YAML is not typical application YAML:
# - Jinja templates can run arbitrarily long on one line
# - unquoted 'on'/'off' are meaningful states, not booleans
# - config files do not start with '---'
# So the default pedantic rules are relaxed here. Syntax errors,
# tabs, duplicate keys, and broken indentation still fail the build.
#
# NOTE: trailing-spaces and new-line-at-end-of-file are temporarily
# disabled to establish a green CI baseline. Existing files have
# trailing whitespace and/or missing final newlines. These rules will
# be re-enabled in a follow-up PR that bulk-fixes the files with a
# whitespace-only cleanup.
extends: default

ignore: |
  bak/
  www/

rules:
  line-length:
    max: 1000
    level: warning
  truthy: disable
  document-start: disable
  comments: disable
  comments-indentation: disable
  trailing-spaces: disable
  new-line-at-end-of-file: disable
  indentation:
    indent-sequences: consistent
  empty-values: disable
